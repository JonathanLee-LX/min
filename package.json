{
  "name": "min",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "min — a minimal, extensible TypeScript agent harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanLee-LX/min"
  },
  "homepage": "https://github.com/JonathanLee-LX/min#readme",
  "bugs": {
    "url": "https://github.com/JonathanLee-LX/min/issues"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r --filter=@min-agent/* run build",
    "test": "pnpm -r --filter=@min-agent/* run test",
    "typecheck": "pnpm -r --filter=@min-agent/* run typecheck",
    "example": "pnpm --filter=@min-agent/example-basic start",
    "example:queue": "pnpm --filter=@min-agent/example-input-queue-scenarios start",
    "min": "pnpm --filter=@min-agent/cli exec tsx src/cli.ts",
    "min-tui": "pnpm --filter=@min-agent/tui exec tsx src/tui.tsx",
    "min-web": "pnpm --filter=@min-agent/webui dev",
    "link:cli": "pnpm --filter=@min-agent/cli run build && pnpm --filter=@min-agent/cli exec pnpm link --global",
    "link:tui": "pnpm --filter=@min-agent/tui run build && pnpm --filter=@min-agent/tui exec pnpm link --global",
    "publish:alpha": "pnpm build && node scripts/release.mjs publish 0.1.0-alpha.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
