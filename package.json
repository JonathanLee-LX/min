{
  "name": "min",
  "private": true,
  "type": "module",
  "description": "min — a minimal, extensible TypeScript agent harness",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r --filter=@min/* run build",
    "test": "pnpm -r --filter=@min/* run test",
    "typecheck": "pnpm -r --filter=@min/* run typecheck",
    "example": "pnpm --filter=@min/example-basic start",
    "example:queue": "pnpm --filter=@min/example-input-queue-scenarios start",
    "min": "pnpm --filter=@min/cli exec tsx src/cli.ts",
    "min-tui": "pnpm --filter=@min/tui exec tsx src/tui.tsx",
    "link:cli": "pnpm --filter=@min/cli run build && pnpm --filter=@min/cli exec pnpm link --global",
    "link:tui": "pnpm --filter=@min/tui run build && pnpm --filter=@min/tui exec pnpm link --global"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
