{
  "name": "@min-agent/tools",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "description": "Minimal workspace tools for the min agent harness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
